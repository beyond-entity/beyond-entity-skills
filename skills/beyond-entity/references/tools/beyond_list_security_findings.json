      "finding_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "fingerprint": {
        "type": [
          "string",
          "null"
        ]
      },
      "model_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "status": {
        "type": [
          "string",
          "null"
        ]
      },
      "rule_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "severity": {
        "type": [
          "string",
          "null"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "display_key": {
        "type": "string",
