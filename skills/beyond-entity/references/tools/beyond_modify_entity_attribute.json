{
  "name": "beyond_modify_entity_attribute",
  "description": "Modify entity attribute properties. For pii_data_type and integer encryption_level, read beyond_get_usage_guide(workflow=\"attribute_security\") or beyond_get_definitions(definition_names=[\"attribute_security_guide\"]).",
  "source_mcp_version": "3.2.53",
  "inputSchema": {
    "type": "object",
    "properties": {
      "attribute_id": {
        "type": "string",
        "description": "Attribute ID to update"
      },
      "updates": {
        "type": "object",
        "properties": {
          "attribute_name": {
            "type": "string"
          },
          "column_name": {
            "type": "string"
          },
          "data_type": {
            "type": "string"
          },
          "data_length": {
            "type": "integer"
          },
          "decimal_points": {
            "type": "integer"
          },
          "nested_data_type": {
            "type": "string"
          },
          "nested_physical_data_type": {
            "type": "string"
          },
          "default_value": {
            "type": "string"
          },
          "enum_values": {
            "type": "string"
          },
          "example_values": {
            "type": "string"
          },
          "is_primary_key": {
            "type": "boolean"
          },
          "is_not_null": {
            "type": "boolean"
          },
          "is_auto_increment": {
            "type": "boolean"
          },
          "encryption_level": {
            "type": "integer",
            "description": "Integer levelNumber: 0=NONE (None), 1=MASKED (Masked), 2=ENCRYPTED (Encrypted), 3=HASHED (Hashed; one-way hash), 4=KEYSERVER (Key Server; encryption key managed by a key server). Writes do not accept null; omission preserves the value on modification.",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ]
          },
          "pii_level": {
            "type": "integer"
          },
          "sensitivity_level": {
            "type": "integer"
          },
          "attribute_description": {
            "type": "string"
          },
          "domain_id": {
            "type": "string"
          },
          "data_depth": {
            "type": "integer"
          },
          "upper_attribute_id": {
            "type": "string"
          },
          "display_order": {
            "type": "integer"
          },
          "other_info": {
            "type": "object"
          },
          "pii_data_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "NA",
              "NAME",
              "CONTACT",
              "ADDRESS",
              "FINANCIAL",
              "SENSITIVE_GENERAL",
              "LOCATION",
              "ONLINE_ID",
              "HEALTH",
              "BIOMETRIC",
              "EMPLOYMENT",
              "DATE_OF_BIRTH",
              "GENERAL_INFO",
              "PASSPORT_NUMBER",
              "NATIONAL_ID",
              "DRIVER_LICENSE",
              "ALIEN_ID",
              "UNIQUE_ID_GENERAL",
              null
            ],
            "description": "PII_DATA_TYPE enum name stored verbatim, e.g. DRIVER_LICENSE. Null clears the classification; this is independent of pii_level."
          }
        }
      }
    },
    "required": [
      "attribute_id",
      "updates"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "data": {
        "type": "object",
        "properties": {
          "attribute_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "output_schema_declared": true
}
